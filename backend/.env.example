PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins in production, or * for any (dev default).
# Example: CORS_ORIGIN=https://www.lokhainnovation.com
CORS_ORIGIN=*

# Protects GET /api/apply and GET /api/contact (submission lists). Leave blank
# to disable those endpoints entirely (safest default — recommended unless
# you're actively building an admin dashboard against them).
ADMIN_API_KEY=

# Optional: email alerts on new submissions. All four must be set for emails
# to actually send; leave blank to skip notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
