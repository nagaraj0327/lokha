generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id         Int      @id @default(autoincrement())
  payload    Json
  receivedAt DateTime @default(now())

  @@map("applications")
}

model Message {
  id         Int      @id @default(autoincrement())
  payload    Json
  receivedAt DateTime @default(now())

  @@map("messages")
}